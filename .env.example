# --- Server ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Gateway API keys: comma-separated name:key[:requests_per_minute] ---
GATEWAY_API_KEYS=demo:sk-gw-demo-change-me:60,batch-jobs:sk-gw-batch-change-me:600
DEFAULT_RPM=60

# --- Providers (a provider is enabled only when configured) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# OLLAMA_BASE_URL=http://localhost:11434
# Offline echo provider for demos/local development
ENABLE_MOCK_PROVIDER=true

# --- Routing: alias -> ordered fallback chain (JSON). Defaults: fast, smart, local, demo ---
# MODEL_ROUTES={"fast":["openai/gpt-4o-mini","anthropic/claude-3-5-haiku-latest","ollama/llama3.1"]}

# --- Resilience ---
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=2
RETRY_BASE_DELAY_MS=250
RETRY_MAX_DELAY_MS=4000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

# --- Cache (temperature-0 requests). 0 disables ---
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

# --- Usage log (JSON lines) ---
# USAGE_LOG_PATH=./usage.jsonl
