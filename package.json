{
  "name": "llm-gateway",
  "version": "0.1.0",
  "description": "OpenAI-compatible LLM API gateway: provider routing, fallback, retries, caching, rate limiting, SSE streaming and usage tracking.",
  "license": "MIT",
  "author": "Hakim Rashid <hakim86.dev@gmail.com>",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "llm",
    "gateway",
    "openai",
    "anthropic",
    "ollama",
    "fastify",
    "typescript"
  ],
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^5.2.6",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
